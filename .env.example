# ---------------------------------------------------------------------------
# AI Shorts Platform — environment configuration (names only; never commit
# real values). Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

NODE_ENV=development
# API port. API_PORT takes precedence over a generic PORT injected by tooling.
API_PORT=8080
LOG_LEVEL=info
# Origin of the dashboard (used for CORS).
WEB_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/ai_shorts
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12
# 32-byte hex key used to encrypt OAuth refresh tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Bootstrap admin: created on API start (or `npm run seed:admin`) if no user
# with this email exists. Remove the password from .env after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Workers ---------------------------------------------------------------
# Comma-separated roles this worker process runs, or "all".
WORKER_ROLES=all
WORKER_HEARTBEAT_SECONDS=10
# Local processing volume for temporary media files.
STORAGE_DIR=./storage
TEMP_FILE_MAX_AGE_HOURS=24

# --- Phase 2+ integrations (not needed for Phase 1) -------------------------
YOUTUBE_API_KEY=
# Channel/live metadata source: `youtube` (needs YOUTUBE_API_KEY) or `mock`
# (dev fixtures; simulate go-live/end from the Streamers page). Empty = auto.
YOUTUBE_METADATA_PROVIDER=
# `rss` (recommended, ~free) or `search` (search.list, 100 quota units/check).
YOUTUBE_LIVE_DETECTION=rss
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Phase 6: youtube = real uploads (needs the OAuth client above), mock = simulated. Blank = auto.
YOUTUBE_UPLOAD_PROVIDER=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/youtube/callback

# Phase 4 — speech-to-text: mock | openai (any Whisper-compatible /audio/transcriptions API)
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
# OpenAI: https://api.openai.com/v1 + whisper-1 ($0.006/min). Groq: https://api.groq.com/openai/v1 + whisper-large-v3-turbo
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_COST_PER_MINUTE=0.006
# Leave blank to auto-detect the spoken language (e.g. en, hi)
TRANSCRIPTION_LANGUAGE=
# Phase 4 — highlight analysis: mock (offline loudness heuristic) | anthropic (Claude) | gemini
LLM_PROVIDER=mock
# Blank = the SDK reads ANTHROPIC_API_KEY
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Google Gemini (LLM_PROVIDER=gemini); blank model = gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=

VIDEO_SOURCE_PROVIDER=local
# Where raw recordings, clips and thumbnails live: `local` (./storage/objects) or `gcs`.
STORAGE_PROVIDER=local
GCS_BUCKET=
GCS_PROJECT_ID=
# Path to the service-account key file (never commit it). Leave empty on Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Defaults (seed values for the Settings document) ----------------------
MAX_CONCURRENT_TRANSCODE_JOBS=2
CHANNEL_MONITOR_INTERVAL_SECONDS=300
DEFAULT_MAX_CLIPS_PER_STREAM=5
DEFAULT_MIN_HIGHLIGHT_SCORE=65

# Phase 7 — optional Telegram alerts (Shorts ready for review, published, failures).
# Bot token from @BotFather; chat id from @userinfobot (or a group id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
